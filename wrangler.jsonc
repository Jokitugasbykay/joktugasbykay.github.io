{
  "name": "jokiin-payment-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-20",
  "vars": {
    "SUPABASE_URL": "https://xdbnwjvxqtpkoaigedsk.supabase.co"
  },
  "routes": [
    { "pattern": "jokiin.my.id/api/*", "zone_name": "jokiin.my.id" },
    { "pattern": "jokiin.my.id/produk-digital*", "zone_name": "jokiin.my.id" },
    { "pattern": "jokiin.my.id/_next/*", "zone_name": "jokiin.my.id" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/produk-digital", "/produk-digital/*"]
  },
  "r2_buckets": [
    { "binding": "TASK_ATTACHMENTS", "bucket_name": "jokiin-task-attachments" }
  ]
}
