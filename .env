# Never commit the real .env file.
APP_URL=[https://jokiin.my.id](https://jokiin.my.id)
MAYAR_ENV=production
MAYAR_API_KEY=
MAYAR_WEBHOOK_SECRET=
# Must match Mayar documentation/dashboard exactly. Empty values reject all webhooks.
MAYAR_WEBHOOK_SIGNATURE_HEADER=
MAYAR_WEBHOOK_SIGNATURE_ALGORITHM=
MAYAR_WEBHOOK_TRANSACTION_ID_PATH=
MAYAR_WEBHOOK_ORDER_ID_PATH=
MAYAR_WEBHOOK_EVENT_PATH=
MAYAR_WEBHOOK_STATUS_PATH=
# Required before a success webhook can mark an order PAID.
MAYAR_TRANSACTION_DETAIL_PATH_TEMPLATE=
MAYAR_TRANSACTION_STATUS_PATH=
MAYAR_TRANSACTION_PAID_STATUS=
# Verify this exact V2 endpoint in Mayar documentation before enabling it.
MAYAR_CREATE_PAYMENT_PATH=
DB_DRIVER=sqlite
DB_PATH=storage/jokiin.sqlite
