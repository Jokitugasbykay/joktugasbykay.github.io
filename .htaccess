Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Server-only files must never be served, even if the web server is misconfigured.
  RewriteRule ^(?:\.env(?:\..*)?|\.git|database/|storage/|api/(?:bootstrap|mayar-config)\.php)$ - [F,L,NC]

  # Keep explicit PHP API endpoints executable; do not route them into the SPA.
  RewriteRule ^api/(?:create-mayar-payment|mayar-webhook|check-status)\.php$ - [L,NC]

  # Existing static files and directories are served normally; every other route is SPA.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  # Deploy this only on a hostname that is permanently HTTPS-only.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
